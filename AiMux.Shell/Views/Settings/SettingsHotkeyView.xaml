<UserControl x:Class="AiMux.Shell.Views.Settings.SettingsHotkeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown">
    <!-- 整页可滚动：八行热键 + 帮助文本在小屏/缩放下会超出一屏，截断问题由此兜底 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20" MaxWidth="780" HorizontalAlignment="Left" Focusable="True">
            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="热键设置" />
            <TextBlock Style="{StaticResource PanelSubStyle}" Margin="0,4,0,0"
                       Text="用下拉框直接选择修饰键与按键，或点「录制」按下组合键自动捕获（必须含修饰键）。按 Esc 取消录制。" />

            <!-- 热键列表：每行 动作 / 修饰键下拉 / 按键下拉 / 录制按钮 -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4,6" Margin="0,20,0,0">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="215" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 动作名 + 说明；录制中变红提示 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Action}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabelStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Foreground" Value="#E81123" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FormHelpStyle}" Margin="0,2,0,0"
                                               Text="{Binding Action, Converter={StaticResource HotkeyActionDescConverter}}" />
                                </StackPanel>

                                <!-- 修饰键下拉 -->
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" MinWidth="108"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AvailableModifiers}"
                                          SelectedItem="{Binding Modifier}"
                                          ToolTip="修饰键，支持组合（如 Ctrl+Alt）" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="+" />

                                <!-- 按键下拉 -->
                                <ComboBox Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" MinWidth="92"
                                          VerticalAlignment="Center" MaxDropDownHeight="320"
                                          ItemsSource="{Binding AvailableKeys}"
                                          SelectedItem="{Binding Key}"
                                          ToolTip="主按键" />

                                <!-- 录制按钮：直接按组合键捕获，兜底下拉里没有的键位 -->
                                <Button Grid.Row="0" Grid.Column="5" Margin="10,0,0,0"
                                        Command="{Binding RecordCommand}"
                                        Style="{StaticResource MiniPrimaryButtonStyle}"
                                        Padding="16,7" VerticalAlignment="Center">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="录制" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Text" Value="停止" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <!-- 录制状态提示（仅录制中显示，不占平时行高） -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,4,0,2"
                                           FontSize="12" Foreground="#E81123"
                                           Text="🔴 请按键…（必须含修饰键，按 Esc 取消）"
                                           Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 底部操作 -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Command="{Binding SaveCommand}" Style="{StaticResource MiniPrimaryButtonStyle}"
                        Content="保存全部" Padding="24,8" />
                <Button Command="{Binding ResetCommand}" Style="{StaticResource MiniButtonStyle}"
                        Content="恢复默认" Padding="16,8" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Style="{StaticResource FormHelpStyle}" Margin="0,16,0,0"
                       Text="内置动作：呼出/隐藏窗口、切换大窗小窗、展开/折叠侧边栏、切换上一个/下一个平台、摸鱼模式切换横竖屏、网页后退/前进。默认快捷键 Alt+Q / Alt+W / Alt+E / Alt+↑ / Alt+↓ / Alt+R / Alt+← / Alt+→，下拉修改后点「保存全部」立即生效。摸鱼模式进出不占热键：大窗按 Esc 进入、小窗按 Esc 退出；小窗顶部按住可拖动，右键也可退出。打开设置没有快捷键，请用主界面右上角按钮。"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
