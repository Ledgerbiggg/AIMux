<UserControl x:Class="AiMux.Shell.Views.Settings.SettingsGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="通用设置" />
            <TextBlock Style="{StaticResource PanelSubStyle}" Margin="0,4,0,0"
                       Text="启动行为与窗口偏好。" />

            <StackPanel Margin="0,18,0,0">
                <TextBlock Style="{StaticResource FormLabelStyle}" Text="默认平台" />
                <ComboBox Height="32" FontSize="13"
                          ItemsSource="{Binding Platforms}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding DefaultPlatformId}" />

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="启动行为" Margin="0,16,0,0" />
                <CheckBox Content="启动后隐藏到托盘，通过热键呼出" IsChecked="{Binding StartHidden}" />
                <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStart}" Margin="0,6,0,0" />

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="窗口记忆" Margin="0,16,0,0" />
                <CheckBox Content="下次启动恢复上次窗口位置与大小" IsChecked="{Binding RememberPosition}" />

                <!-- 小窗 / 大窗尺寸（滑块，带范围限制） -->
                <TextBlock Style="{StaticResource FormLabelStyle}" Text="小窗尺寸" Margin="0,18,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="宽度" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Slider Grid.Column="1" Minimum="360" Maximum="900"
                            Value="{Binding CompactWidth}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding CompactWidth, StringFormat='{}{0:0}'}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="高度" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Slider Grid.Column="1" Minimum="480" Maximum="1100"
                            Value="{Binding CompactHeight}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding CompactHeight, StringFormat='{}{0:0}'}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="大窗尺寸" Margin="0,18,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="宽度" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Slider Grid.Column="1" Minimum="800" Maximum="2560"
                            Value="{Binding FullWidth}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding FullWidth, StringFormat='{}{0:0}'}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="高度" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Slider Grid.Column="1" Minimum="600" Maximum="1600"
                            Value="{Binding FullHeight}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding FullHeight, StringFormat='{}{0:0}'}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Style="{StaticResource MiniPrimaryButtonStyle}" Command="{Binding SaveCommand}"
                            Content="保存" Padding="20,6" />
                </StackPanel>

                <Border Margin="0,26,0,0" Padding="14,12" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="配置备份与迁移" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="将当前设置（窗口尺寸、热键、主题、默认平台）与全部网站列表导出为一个文件；导入后可快速恢复或迁移到其它电脑。"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MiniPrimaryButtonStyle}" Command="{Binding ExportCommand}"
                                    Content="导出配置" Padding="16,6" Margin="0,0,10,0" />
                            <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding ImportCommand}"
                                    Content="导入配置" Padding="16,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="恢复默认配置" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="将清空所有平台、窗口尺寸、热键与外观设置，恢复到首次安装时的初始状态（不影响已登录的网页账号）。"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding ResetCommand}"
                                Content="恢复默认配置" Padding="16,6" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,18,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="当前版本：" />
                    <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
