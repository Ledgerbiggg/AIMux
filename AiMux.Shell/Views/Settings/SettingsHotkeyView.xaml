<UserControl x:Class="AiMux.Shell.Views.Settings.SettingsHotkeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="24,20,24,20" MaxWidth="780" HorizontalAlignment="Left" Focusable="True">
        <TextBlock Style="{StaticResource PanelTitleStyle}" Text="热键设置" />
        <TextBlock Style="{StaticResource PanelSubStyle}" Margin="0,4,0,0"
                   Text="管理所有全局热键。点击「录制」按钮，按下组合键即可捕获（必须含修饰键）。按 Esc 取消录制。" />

        <!-- 热键列表：每行显示 动作 / 组合键 / 录制按钮 -->
        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="4,6" Margin="0,20,0,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 动作选择 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FormLabelStyle}" Text="{Binding Action}" />
                                <TextBlock Style="{StaticResource FormHelpStyle}" Margin="0,2,0,0"
                                           Text="{Binding Action, Converter={StaticResource HotkeyActionDescConverter}}" />
                            </StackPanel>

                            <!-- 当前组合键显示 -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="14,8" MinWidth="160">
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               Text="{Binding Display}" />
                                </Border>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Text" Value="🔴 请按键…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- 录制按钮 -->
                            <Button Grid.Column="2" Margin="10,0,0,0"
                                    Command="{Binding RecordCommand}"
                                    Style="{StaticResource MiniPrimaryButtonStyle}"
                                    Padding="18,10" VerticalAlignment="Center">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="录制" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Text" Value="停止" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 底部操作 -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Command="{Binding SaveCommand}" Style="{StaticResource MiniPrimaryButtonStyle}"
                    Content="保存全部" Padding="24,8" />
            <Button Command="{Binding ResetCommand}" Style="{StaticResource MiniButtonStyle}"
                    Content="恢复默认" Padding="16,8" Margin="10,0,0,0" />
        </StackPanel>

        <TextBlock Style="{StaticResource FormHelpStyle}" Margin="0,16,0,0"
                   Text="内置动作：呼出/隐藏窗口、展开/折叠侧边栏、切换上一个/下一个平台。默认快捷键 Alt+Q / Alt+W / Alt+← / Alt+→，可点击「录制」修改。" />
    </StackPanel>
</UserControl>