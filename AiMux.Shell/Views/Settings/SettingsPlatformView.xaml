<UserControl x:Class="AiMux.Shell.Views.Settings.SettingsPlatformView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：标题 + 平台列表 -->
        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="平台管理" />
            <TextBlock Style="{StaticResource PanelSubStyle}" Margin="0,4,16,16"
                       Text="管理聚合的 AI 平台。图标优先自动获取网站 favicon，也可填写图片链接。配置保存在本地，下次启动自动加载。" />
            <TextBlock Text="拖动列表项可调整顺序（与主界面侧边栏实时同步）" FontSize="11.5"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
            <ListBox x:Name="PlatformsListBox" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource PlatformRowStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="PlatformsList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="PlatformsList_PreviewMouseMove"
                     DragOver="PlatformsList_DragOver"
                     Drop="PlatformsList_Drop">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="Transparent">
                                <Grid>
                                    <TextBlock Text="{Binding Name[0]}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Url}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 新增平台：虚线占位样式，Fluent 风格 -->
            <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding AddCommand}" Margin="0,4,0,0" Padding="12,9"
                    HorizontalContentAlignment="Center"
                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}">
                <TextBlock Text="＋ 新增平台" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12.5" />
            </Button>
        </StackPanel>

        <!-- 右：编辑表单卡片（对齐原型 form-card，Fluent 风格） -->
        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="22,20" Margin="24,0,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource PanelTitleStyle}" Text="编辑平台" />
                <TextBlock Style="{StaticResource PanelSubStyle}" Margin="0,4,0,18"
                           Text="修改后点击保存生效。" />

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="平台名称" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" />

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="网页地址 URL" Margin="0,16,0,0" />
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" />
                <TextBlock Style="{StaticResource FormHelpStyle}"
                           Text="填入平台网页版地址，软件将内嵌访问。此地址保存在本地配置文件 platforms.json。" />

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="图标 Icon" Margin="0,16,0,0" />
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="48" Height="48">
                        <!-- 虚线预览框（Fluent 圆角） -->
                        <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource ControlElevationBorderBrush}"
                                   StrokeDashArray="3 2" StrokeThickness="1" />
                        <Image Source="{Binding IconPreview}" Stretch="Uniform" StretchDirection="Both" Margin="2" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MiniPrimaryButtonStyle}" Command="{Binding AutoFetchIconCommand}"
                                    Content="↺ 自动获取 favicon" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource FormHelpStyle}" Margin="0,4,0,0"
                                   Text="网页加载完成后会自动抓取 favicon，也可在此手动触发。" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="图标图片链接（可选）" Margin="0,16,0,0" />
                <TextBox Text="{Binding IconLink, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"
                         ToolTip="填入图片直链（http/https），将作为平台图标" />
                <TextBlock Style="{StaticResource FormHelpStyle}"
                           Text="直接粘贴一张图片链接作为图标；留空则使用上方抓取到的 favicon。" />

                <CheckBox Content="在侧边栏显示此平台" IsChecked="{Binding Enabled}" Margin="0,16,0,0" />

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource MiniButtonStyle}" Command="{Binding DeleteCommand}"
                            Content="删除平台" Foreground="#C42B1C" BorderBrush="#C42B1C" />
                    <Button Grid.Column="2" Style="{StaticResource MiniPrimaryButtonStyle}" Command="{Binding SaveCommand}"
                            Content="保存" Padding="28,7" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
