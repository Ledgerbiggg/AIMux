#!/usr/bin/env bash
# Git pre-push hook（AiMux：WPF/.NET 项目）
#
# 历史说明：本文件曾误用 Node 项目模板（cd app + npm run build + .VERSION 自增），
# 因本项目不存在 app 目录导致 push 永远失败，已重写。
#
# 本项目发布约定（与 GitHub Actions build.yml 配合）：
#   - 版本号唯一真相源：AiMux.Shell/AiMux.Shell.csproj 的 <Version>
#   - 版本自增 + Release 说明由 scripts/release.ps1 在本地完成并提交
#   - 构建校验由云端工作流完成（push 后自动打包，失败会反馈到 Actions）
# 故此处不做构建、不做版本自增，仅做轻量提示后放行。

echo "[pre-push] AiMux: 版本与出包由 release.ps1 + GitHub Actions 管理，直接放行。"
exit 0
