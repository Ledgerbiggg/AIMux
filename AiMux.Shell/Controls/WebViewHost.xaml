<UserControl x:Class="AiMux.Shell.Controls.WebViewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="{DynamicResource ControlFillColorDefaultBrush}">
        <!-- 平台网页实例 -->
        <wv2:WebView2 x:Name="WebView" NavigationCompleted="WebView_OnNavigationCompleted" />

        <!-- 加载占位层（对齐原型 webview-placeholder，网页就绪后隐藏） -->
        <Grid x:Name="Placeholder">
            <Grid.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#080067C0">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="24,0" />
                                    <LineGeometry StartPoint="0,0" EndPoint="0,24" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="BigIcon" Width="56" Height="56" CornerRadius="14"
                        Background="{DynamicResource BrandGradientBrush}" HorizontalAlignment="Center">
                    <TextBlock x:Name="BigIconText" Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,16,0,0"
                           HorizontalAlignment="Center" Text="网页版加载中…" />
                <TextBlock x:Name="SubText" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,8,0,0" HorizontalAlignment="Center"
                           Text="登录态通过 Cookie 持久化，重启软件无需重新登录" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
