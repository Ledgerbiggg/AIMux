<UserControl x:Class="AiMux.Shell.Views.Settings.SettingsSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AiMux.Shell.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsSyncViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="配置同步" />
            <TextBlock Style="{StaticResource PanelSubStyle}" Margin="0,4,0,0"
                       Text="通过 WebDAV 服务器统一管理多设备配置，或使用本地文件导入导出配置。" />

            <!-- WebDAV 服务器配置 -->
            <StackPanel Margin="0,18,0,0">
                <TextBlock Style="{StaticResource FormLabelStyle}" Text="WebDAV 路径" />
                <ui:TextBox Height="34" FontSize="13.5" Padding="12,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="https://dav.example.com/AiMux" />
                <TextBlock Style="{StaticResource FormHelpStyle}"
                           Text="直接填写配置文件存放的完整路径，配置文件将创建在此路径下" />

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="用户名" Margin="0,14,0,0" />
                <ui:TextBox Height="34" FontSize="13.5" Padding="12,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="WebDAV 用户名" />

                <TextBlock Style="{StaticResource FormLabelStyle}" Text="密码" Margin="0,14,0,0" />
                <ui:PasswordBox x:Name="PwdBox" Height="34" FontSize="13.5" Padding="12,0"
                                VerticalContentAlignment="Center"
                                PasswordChar="*"
                                PasswordChanged="OnPasswordChanged" />

                <CheckBox Content="保存设置时自动上传到 WebDAV" IsChecked="{Binding AutoSync}" Margin="0,14,0,0" />
            </StackPanel>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button Style="{StaticResource MiniPrimaryButtonStyle}" Command="{Binding SaveCommand}"
                        Content="保存配置" Padding="16,6" Margin="0,0,10,0"
                        IsEnabled="{Binding CanOperate}" />
                <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding TestCommand}"
                        Content="测试连接" Padding="16,6" Margin="0,0,10,0"
                        IsEnabled="{Binding CanOperate}" />
            </StackPanel>

            <!-- 同步操作卡片 -->
            <Border Margin="0,20,0,0" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="配置同步操作" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="上传：将当前本地配置推送到 WebDAV 服务器；拉取：从服务器获取远程配置并覆盖本地（应用后需重启）。"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MiniPrimaryButtonStyle}" Command="{Binding UploadCommand}"
                                Content="上传配置" Padding="16,6" Margin="0,0,10,0"
                                IsEnabled="{Binding CanOperate}" />
                        <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding DownloadCommand}"
                                Content="拉取配置" Padding="16,6"
                                IsEnabled="{Binding CanOperate}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 状态显示 -->
            <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{Binding Status}" />

            <!-- 本地配置导入导出卡片 -->
            <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="本地配置备份与迁移" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="将当前设置与全部网站列表导出为一个 .aimux 文件；导入后可快速恢复或迁移到其它电脑。"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MiniPrimaryButtonStyle}" Command="{Binding ExportCommand}"
                                Content="导出配置" Padding="16,6" Margin="0,0,10,0" />
                        <Button Style="{StaticResource MiniButtonStyle}" Command="{Binding ImportCommand}"
                                Content="导入配置" Padding="16,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 上次同步时间 -->
            <TextBlock Margin="0,8,0,20" FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="上次同步：" />
                <Run Text="{Binding LastSyncDisplay, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
