<Project Sdk="Microsoft.NET.Sdk">    <PropertyGroup>     <OutputType>WinExe</OutputType>     <TargetFramework>net9.0-windows</TargetFramework>     <Nullable>enable</Nullable>     <ImplicitUsings>enable</ImplicitUsings>     <UseWPF>true</UseWPF>     <RootNamespace>AiMux.Shell</RootNamespace>     <AssemblyName>AiMux</AssemblyName>     <!-- TODO 统一版本号：程序集版本 / 文件版本 / 安装包版本都从这里取，后期更新以此为准 -->     <Version>0.0.3</Version>     <!-- 应用图标：嵌入 exe，使任务栏/快捷方式/安装后程序均显示 AiMux 图标（非默认） -->     <ApplicationIcon>Assets\app-icon_ico_128x128.ico</ApplicationIcon>   </PropertyGroup>    <ItemGroup>     <ProjectReference Include="..\AiMux.Common\AiMux.Common.csproj" />     <ProjectReference Include="..\AiMux.Models\AiMux.Models.csproj" />     <ProjectReference Include="..\AiMux.Services\AiMux.Services.csproj" />   </ItemGroup>    <ItemGroup>     <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />     <PackageReference Include="Prism.Unity" Version="8.1.97" />     <PackageReference Include="WPF-UI" Version="4.0.0" />   </ItemGroup>    <!-- 应用图标与资源图片：打包进 exe，运行时通过 pack://application:,,,/Assets/... 访问 -->   <ItemGroup>     <Resource Include="Assets\**\*" />   </ItemGroup>    <!-- 托盘 .ico：作为内容复制到输出目录，供 NotifyIcon 从文件系统加载 -->   <ItemGroup>     <Content Include="Assets\app-icon_ico_128x128.ico">       <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>     </Content>   </ItemGroup>  <!-- 版本说明文件：复制到输出目录，作为安装后程序读取版本号/更新说明的唯一来源（开发期也在 BaseDirectory 下，路径稳定） -->   <ItemGroup>     <Content Include="..\version.json">       <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>       <Link>version.json</Link>     </Content>   </ItemGroup> </Project>
